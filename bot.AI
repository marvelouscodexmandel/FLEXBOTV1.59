{
  "name": "flexbot-ai",
  "version": "1.0.0",
  "description": "FlexBot AI - WhatsApp + Telegram AI bot",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.0.0"
  }
}
// ============================================================
//  FlexBot AI  -  WhatsApp + Telegram AI bot
//  Run with:  node index.js
// ============================================================
import makeWASocket, {
  useMultiFileAuthState,
  DisconnectReason,
  fetchLatestBaileysVersion,
  Browsers,
} from '@whiskeysockets/baileys';
import TelegramBot from 'node-telegram-bot-api';
import pino from 'pino';

// ===================== EDIT THESE 3 THINGS =====================
const CONFIG = {
  // From https://console.anthropic.com  (API keys)
  ANTHROPIC_API_KEY: 'PASTE_YOUR_ANTHROPIC_KEY',
  // From @BotFather on Telegram (leave as is to skip Telegram)
  TELEGRAM_TOKEN: 'PASTE_YOUR_TELEGRAM_TOKEN',
  // The WhatsApp number the bot will use: country code + number,
  // digits only, no + or spaces. Example: 15551234567
  // (leave as is to skip WhatsApp)
  WHATSAPP_NUMBER: 'PASTE_YOUR_WHATSAPP_NUMBER',

  MODEL: 'claude-sonnet-5-5',
  BOT_NAME: 'FlexBot AI',
};
// ================================================================

const SYSTEM = `You are ${CONFIG.BOT_NAME}, a friendly and helpful AI assistant chatting on WhatsApp and Telegram. Keep replies short, clear and easy to read on a phone (under 150 words unless the person asks for more). Use plain text, no markdown tables or headers.`;

const HELP = `👋 I'm ${CONFIG.BOT_NAME}!

Just send me a message and I'll reply.

Commands:
/help or !help - show this menu
/clear or !clear - forget our conversation
/ping or !ping - check I'm alive

In WhatsApp groups, start your message with !ai
Example: !ai tell me a joke`;

// ---------- Per-chat memory (last 10 exchanges) ----------
const histories = new Map();
const queues = new Map();

function enqueue(chatId, task) {
  const prev = queues.get(chatId) ?? Promise.resolve();
  const next = prev.then(task).catch((e) => console.error('Task error:', e));
  queues.set(chatId, next);
  return next;
}

// ---------- AI ----------
async function askAI(chatId, text) {
  const history = histories.get(chatId) ?? [];
  histories.set(chatId, history);
  history.push({ role: 'user', content: text });

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-api-key': CONFIG.ANTHROPIC_API_KEY,
        'anthropic-version': '2023-06-01',
      },
      body: JSON.stringify({
        model: CONFIG.MODEL,
        max_tokens: 700,
        system: SYSTEM,
        messages: history,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data?.error?.message || `HTTP ${res.status}`);

    const reply =
      data.content
        .filter((b) => b.type === 'text')
        .map((b) => b.text)
        .join('\n')
        .trim() || '🤔 I have nothing to say to that.';

    history.push({ role: 'assistant', content: reply });
    while (history.length > 20) history.splice(0, 2); // keep pairs
    return reply;
  } catch (err) {
    history.pop(); // remove the failed user message
    throw err;
  }
}

// ---------- Shared message logic (used by both platforms) ----------
async function handle(chatId, text, reply, typing) {
  let t = text.trim();
  if (!t) return;

  const m = t.match(/^[\/!](\w+)(?:@\w+)?\s*([\s\S]*)$/);
  if (m) {
    const cmd = m[1].toLowerCase();
    const rest = m[2].trim();
    if (cmd === 'start' || cmd === 'help') return reply(HELP);
    if (cmd === 'ping') return reply('pong 🏓');
    if (cmd === 'clear') {
      histories.delete(chatId);
      return reply('🧹 Memory cleared. Fresh start!');
    }
    if (cmd === 'ai') {
      if (!rest) return reply('Type your question after !ai');
      t = rest;
    }
  }

  try {
    await typing();
    const answer = await askAI(chatId, t);
    await reply(answer);
  } catch (err) {
    console.error('AI error:', err.message);
    await reply('⚠️ Sorry, something went wrong. Please try again in a moment.');
  }
}

// ---------- WhatsApp ----------
let pairingRequested = false;

async function startWhatsApp() {
  const { state, saveCreds } = await useMultiFileAuthState('wa_auth');
  const { version } = await fetchLatestBaileysVersion();

  const sock = makeWASocket({
    version,
    auth: state,
    logger: pino({ level: 'silent' }),
    browser: Browsers.ubuntu('Chrome'),
    printQRInTerminal: false,
  });

  sock.ev.on('creds.update', saveCreds);

  // Link with a pairing code (no QR needed - great for phone-only)
  if (!sock.authState.creds.registered && !pairingRequested) {
    pairingRequested = true;
    await new Promise((r) => setTimeout(r, 3000));
    try {
      const code = await sock.requestPairingCode(CONFIG.WHATSAPP_NUMBER);
      console.log('\n==============================================');
      console.log(`  WHATSAPP PAIRING CODE:  ${code}`);
      console.log('  WhatsApp > Settings > Linked devices > Link a device');
      console.log('  > "Link with phone number instead" > enter the code');
      console.log('==============================================\n');
    } catch (e) {
      console.error('Could not get pairing code:', e.message);
      pairingRequested = false;
    }
  }

  sock.ev.on('connection.update', ({ connection, lastDisconnect }) => {
    if (connection === 'open') {
      console.log('✅ WhatsApp connected');
    } else if (connection === 'close') {
      const code = lastDisconnect?.error?.output?.statusCode;
      if (code === DisconnectReason.loggedOut) {
        console.log('❌ WhatsApp logged out. Delete the "wa_auth" folder and run again.');
      } else {
        console.log('🔄 WhatsApp reconnecting...');
        startWhatsApp().catch((e) => console.error(e));
      }
    }
  });

  sock.ev.on('messages.upsert', async ({ messages, type }) => {
    if (type !== 'notify') return;
    for (const msg of messages) {
      if (!msg.message || msg.key.fromMe) continue;
      const jid = msg.key.remoteJid;
      if (!jid || jid === 'status@broadcast' || jid.endsWith('@newsletter')) continue;

      const m = msg.message;
      const text =
        m.conversation ||
        m.extendedTextMessage?.text ||
        m.imageMessage?.caption ||
        m.videoMessage?.caption ||
        '';
      if (!text.trim()) continue;

      // In groups, only answer messages that start with "!"
      const isGroup = jid.endsWith('@g.us');
      if (isGroup && !text.trim().startsWith('!')) continue;

      enqueue(jid, () =>
        handle(
          jid,
          text,
          (t) => sock.sendMessage(jid, { text: t }, { quoted: msg }),
          () => sock.sendPresenceUpdate('composing', jid)
        )
      );
    }
  });
}

// ---------- Telegram ----------
function startTelegram() {
  const bot = new TelegramBot(CONFIG.TELEGRAM_TOKEN, { polling: true });
  let username = '';

  bot
    .getMe()
    .then((me) => {
      username = me.username;
      console.log(`✅ Telegram connected as @${me.username}`);
    })
    .catch((e) => console.error('Telegram error:', e.message));

  bot.on('polling_error', (e) => console.error('Telegram polling error:', e.message));

  bot.on('message', (msg) => {
    const text = msg.text;
    if (!text) return;

    const isGroup = msg.chat.type !== 'private';
    if (isGroup) {
      const mentioned = username && text.toLowerCase().includes('@' + username.toLowerCase());
      if (!mentioned && !text.startsWith('/')) return;
    }

    const clean = username ? text.replace(new RegExp('@' + username, 'ig'), '').trim() : text;
    const chatId = `tg:${msg.chat.id}`;

    enqueue(chatId, () =>
      handle(
        chatId,
        clean,
        (t) => bot.sendMessage(msg.chat.id, t),
        () => bot.sendChatAction(msg.chat.id, 'typing')
      )
    );
  });
}

// ---------- Start everything ----------
process.on('unhandledRejection', (e) => console.error('Unhandled:', e));

if (CONFIG.ANTHROPIC_API_KEY.includes('PASTE')) {
  console.error('❌ Put your Anthropic API key in CONFIG at the top of index.js');
  process.exit(1);
}

console.log(`🚀 Starting ${CONFIG.BOT_NAME}...`);

if (!CONFIG.TELEGRAM_TOKEN.includes('PASTE')) startTelegram();
else console.log('⏭️  Telegram skipped (no token set)');

if (!CONFIG.WHATSAPP_NUMBER.includes('PASTE')) startWhatsApp().catch((e) => console.error(e));
else console.log('⏭️  WhatsApp skipped (no number set)');
